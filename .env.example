# Copy to .env and fill in. Never commit .env.

# Your time zone: dates in the app and the nightly backup time use it.
TZ=America/Los_Angeles

# How people sign in: "password" (the app's own sign-in; serve it over HTTPS, see
# the README) or "cloudflare" (Cloudflare Access in front of the app).
AUTH_MODE=password

# Cloudflare Access (AUTH_MODE=cloudflare only): the team domain is shown under
# Zero Trust > Settings; the AUD tag is on the Access application's Overview tab.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# First logins for a brand-new database, as email=Person name. Optional: in password
# mode the first visit asks you to create your login instead. Ignored once anyone
# has a login; after that, manage logins in Settings > App users.
# APP_USERS=alex@example.com=Alex,sam@example.com=Sam

# Port the app listens on, on this machine.
# PORT=8000

# Which version to run. The default, 1, follows every 1.x release. Pin one (1.1.0)
# to update only when you change this; "latest" is every change as it's merged,
# before it's been tried out (for testing).
# LUMPOFCOAL_VERSION=1

# Nightly backups (see README "Backups"): uncomment to start the backup service.
# BACKUP_DIR is the folder on this machine they go to; ideally another disk or a
# network share, since a backup on the same disk won't survive that disk failing.
# COMPOSE_PROFILES=backup
# BACKUP_DIR=./backups
# BACKUP_AT=00:30
# BACKUP_KEEP_DAYS=30

# Local development only: bypasses sign-in. Must be an app user's email, and the
# app refuses to start if CF_ACCESS_AUD is also set.
# DEV_USER=alex@example.com
